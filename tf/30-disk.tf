# Образ ОС фиксируем по ID, а не по семейству.
# С семейством (family = "ubuntu-2404-lts") Terraform следит за обновлениями
# образа в облаке: как только Yandex выкладывает новый, image_id меняется,
# а это поле ForceNew — и plan предлагает пересоздать ВСЕ машины разом.
# Для воспроизводимых пересборок ID прибит; обновление — осознанная смена
# значения в переменной default_image.
data "yandex_compute_image" "default" {
  image_id = var.default_image
}