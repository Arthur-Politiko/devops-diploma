# Ingress для Grafana.
# Рендерится плейбуком ansible/31-ingress.yaml: имя хоста собирается из домена
# ingress_domain (по умолчанию debugmonkey.ru). В зоне домена заведена
# wildcard-запись *.debugmonkey.ru на статический адрес NAT-ноды.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grafana
  namespace: monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: kube-prometheus-stack
spec:
  ingressClassName: nginx
  rules:
    - host: {{ ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kube-prometheus-stack-grafana
                port:
                  number: 80
